{
  "name": "learning-academy",
  "version": "1.2.5",
  "description": "Learning Academy — universal multi-course learning client with installable .lacourse packages, Daily Challenges, global Academy XP, branded desktop icon and full in-app banner branding, per-course progress, backups, and automatic app updates.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run validate && electron-builder --win --publish never",
    "release": "npm run validate && electron-builder --win --publish always",
    "validate": "node validate.js"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.personal.12monthacademy",
    "productName": "Learning Academy",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "validate.js",
      "courses/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/learning-academy.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MedicBoy",
        "repo": "12-month-academy",
        "releaseType": "release"
      }
    ],
    "artifactName": "Learning-Academy-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "adm-zip": "^0.6.0"
  }
}
