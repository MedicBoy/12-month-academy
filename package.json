{
  "name": "learning-academy",
  "version": "1.3.1",
  "description": "Learning Academy \u2014 commercial learning platform with secure account authentication foundation, first-run onboarding, learner profiles, goals, Academy XP/levels, country flags, leaderboard, installable .lacourse packages, progress backups, and automatic updates.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run validate && electron-builder --win --publish never",
    "release": "npm run validate && electron-builder --win --publish always",
    "validate": "node validate.js"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.personal.12monthacademy",
    "productName": "Learning Academy",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "validate.js",
      "courses/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/learning-academy.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MedicBoy",
        "repo": "12-month-academy",
        "releaseType": "release"
      }
    ],
    "artifactName": "Learning-Academy-Setup-${version}.${ext}",
    "protocols": [
      {
        "name": "Learning Academy",
        "schemes": [
          "learning-academy"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "adm-zip": "^0.6.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "learningAcademyBackend": {
    "provider": "supabase",
    "url": "",
    "publishableKey": "",
    "authRedirect": "learning-academy://auth/callback",
    "passwordResetRedirect": "learning-academy://auth/reset"
  }
}
